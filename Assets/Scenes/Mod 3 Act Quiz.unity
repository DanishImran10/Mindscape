--- !u!114 &1245705289
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1245705284}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 80f53e7eb1b270c4a92f77678a73fa9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - questionText: Which of the following can act as a PTSD trigger?
    options:
    - A specific smell
    - A loud noise
    - A place associated with trauma
    - All of the above
    correctAnswerIndex: 3
    questionAudio: {fileID: 8300000, guid: d99412ba0356d254c93358afbcd8bc49, type: 3}
  - questionText: What happens during a PTSD flashback?
    options:
    - "The person imagines the traumatic event but knows it isn\u2019t real"
    - The person feels as if they are reliving the traumatic event
    - "The person gets sad but doesn\u2019t recall details"
    - The person instantly forgets the trauma
    correctAnswerIndex: 1
    questionAudio: {fileID: 8300000, guid: 5912891901c8c84479ef6634a7559ab7, type: 3}
  - questionText: Why does the brain form PTSD triggers?
    options:
    - To make the person remember trauma
    - Because memories during trauma are stored without full context
    - As a way to prevent future trauma
    - Due to genetics
    correctAnswerIndex: 1
    questionAudio: {fileID: 8300000, guid: ccdb2e45b1dec214a96aa6a5724263a5, type: 3}
  - questionText: Which trigger is more likely to cause a severe PTSD reaction?
    options:
    - A faint smell that reminds a person of the trauma
    - Revisiting the exact location of the trauma
    - Seeing a general object that resembles something from the past
    - Listening to calming music
    correctAnswerIndex: 1
    questionAudio: {fileID: 8300000, guid: 06e463277cf9cca42b4e4c613fe5fd6d, type: 3}
  - questionText: What is one common way to manage a PTSD trigger?
    options:
    - Avoiding all reminders forever
    - Using grounding techniques
    - Ignoring it until it goes away
    - Reacting aggressively to regain control
    correctAnswerIndex: 1
    questionAudio: {fileID: 8300000, guid: 418816f45f9c48d4ebc69bacd7ca2fe4, type: 3}
  questionText: {fileID: 256163125}
  optionTexts:
  - {fileID: 512431226}
  - {fileID: 1030892138}
  - {fileID: 2036620280}
  - {fileID: 1078989063}
  optionButtons:
  - {fileID: 1044545364}
  - {fileID: 1587975153}
